# ============================================================
# 文字轉語音 v3.0 — Hermes TTS + Podcast 後製
# ============================================================
# 任何外部 API 一律走環境變數；本檔是 deployed env 對照表

# ─── TTS 引擎（Hermes 統一介面，5 引擎聚合）────────────────
# OpenAI gpt-4o-mini-tts（預設）
OPENAI_API_KEY=sk-...

# ElevenLabs Multilingual v2（高音質）
ELEVENLABS_API_KEY=...

# Kokoro via inference.sh（開源）
KOKORO_API_KEY=...
# 兼容別名
INFERENCE_SH_API_KEY=...

# Azure Neural TTS（繁中品質好）
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastasia

# Google Cloud TTS
GOOGLE_TTS_API_KEY=...
# 兼容別名
GOOGLE_API_KEY=...

# ─── 用戶系統（Clerk）──────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── 資料儲存（Vercel KV）──────────────────────────────
KV_REST_API_URL=https://....kv.vercel-storage.com
KV_REST_API_TOKEN=...

# ─── 後製：Whisper / GPT 章節（OpenAI Whisper + GPT-4o-mini）──
# 與 OPENAI_API_KEY 共用即可

# ─── 後製：Modal GPU Worker（可選，留空則走 Groq 備援）────
MODAL_TOKEN_ID=...
MODAL_TOKEN_SECRET=...

# Groq Whisper fallback（CPU）
GROQ_API_KEY=...

# ─── 通知：Email (Resend) + Webhook ──────────────────────
RESEND_API_KEY=re_...
NOTIFY_FROM_EMAIL=noreply@text-to-speech-mvp.vercel.app

# ─── 訂閱金流（NewebPay 藍新）───────────────────────────
# MERN 環境
NEWEBPAY_MERCHANT_ID=...
NEWEBPAY_HASH_KEY=...
NEWEBPAY_HASH_IV=...
NEWEBPAY_RETURN_URL=https://text-to-speech-mvp.vercel.app/billing/success
NEWEBPAY_NOTIFY_URL=https://text-to-speech-mvp.vercel.app/api/webhook/newebpay

# ─── 安全：HMAC 密鑰（webhook 簽章）───────────────────────
WEBHOOK_SECRET=change-me-to-random-32-bytes

# ─── 三層 tier 額度（可由 Vercel env 覆寫）────────────────
# 個人版 NT$99 = TTS 30 分/月 + 後製 1 hr/月
# 創作者 NT$299 = TTS 3 hr/月 + 後製 10 hr/月
# 企業 API NT$2,999 = TTS 50 hr/月 + 後製 200 hr/月
TIER_FREE_TTS_MIN=5
TIER_FREE_PROD_MIN=30
TIER_PERSONAL_TTS_MIN=30
TIER_PERSONAL_PROD_MIN=60
TIER_CREATOR_TTS_MIN=180
TIER_CREATOR_PROD_MIN=600
TIER_BUSINESS_TTS_MIN=3000
TIER_BUSINESS_PROD_MIN=12000
